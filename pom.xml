<?xml version="1.0" encoding="UTF-8"?>
<project>
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>        <!-- your organization -->
    <artifactId>calculator</artifactId>   <!-- project name -->
    <version>1.0-SNAPSHOT</version>       <!-- current version -->

<dependencies>
        <!-- JSON parsing library by Google -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.13.2</version> <!-- https://mvnrepository.com/artifact/com.google.code.gson/gson -->
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- CheckStyle: checks formatting, naming, structure (like a grammar checker)
                 Run with: mvn checkstyle:check -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version> <!-- https://search.maven.org/artifact/org.apache.maven.plugins/maven-checkstyle-plugin -->
                <configuration>
                    <configLocation>google_checks.xml</configLocation>
                    <violationSeverity>warning</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                </configuration>
            </plugin>
            <!-- PMD: checks bad patterns, dead code, complexity (like a writing style advisor)
                 Run with: mvn pmd:check -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version> <!-- https://search.maven.org/artifact/org.apache.maven.plugins/maven-pmd-plugin -->
                <configuration>
                    <failOnViolation>true</failOnViolation>
                </configuration>
            </plugin>
            <!-- SpotBugs: checks actual bugs, null pointers, resource leaks in bytecode (like a bug detector)
                 Run with: mvn spotbugs:check -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.8.3</version> <!-- https://search.maven.org/artifact/com.github.spotbugs/spotbugs-maven-plugin -->
                <configuration>
                    <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!-- Run all three together: mvn clean compile checkstyle:check pmd:check spotbugs:check -->

    <!--
        Maven build commands (Exercise 2.3: Read vs Write classification):
        mvn compile         — does it build? (phases 1-7)              [Write local]
        mvn test            — do tests pass? (phases 1-15)             [Write local]
        mvn package         — create the deliverable (phases 1-17)     [Write local]
        mvn clean           — delete target/ directory                 [Write local]
        mvn clean package   — fresh build from scratch                 [Write local]
        mvn clean install   — build + local repository (phases 1-22)   [Write local]
        mvn deploy          — upload to remote repository (phases 1-23)[Write external]
        mvn dependency:tree — show all dependencies                    [Read]

        Maven Build Lifecycle (23 phases):
         1  validate                Check project is correct & all info available
         2  initialize              Set up build state (properties, directories)
         3  generate-sources        Generate source code (e.g. from WSDL/XSD)
         4  process-sources         Filter/process source code
         5  generate-resources      Generate resources for packaging
         6  process-resources       Copy resources to target/classes
         7  compile                 Compile src/main/java → target/classes
         8  process-classes         Post-process .class files (e.g. bytecode enhancement)
         9  generate-test-sources   Generate test source code
        10  process-test-sources    Filter/process test source code
        11  generate-test-resources Generate test resources
        12  process-test-resources  Copy test resources to target/test-classes
        13  test-compile            Compile src/test/java → target/test-classes
        14  process-test-classes    Post-process test .class files
        15  test                    Run unit tests (fails → build stops)
        16  prepare-package         Final preparation before packaging
        17  package                 Create .jar or .war in target/
        18  pre-integration-test    Set up integration test environment
        19  integration-test        Run integration tests
        20  post-integration-test   Tear down integration test environment
        21  verify                  Run quality checks (CheckStyle, PMD, SpotBugs)
        22  install                 Copy .jar to local ~/.m2/ repository
        23  deploy                  Upload to remote repository (Nexus)
    -->
</project>
